# Optional for local demo; required for real ElevenLabs voice.
# Copy to .env.local. Never use NEXT_PUBLIC_ for secrets.
ELEVENLABS_API_KEY=

# Defaults used when blank/unset:
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Optional overrides. Defaults are premade voices verified for this app:
# supportive Sarah EXAVITQu4vr4xnSDxMaL, drill Adam pNInz6obpgDQGcFmaJgB,
# hype Liam TX3LPaxmHKxFdv7VOQHJ, calm River SAz9YHcvj6GT2YYXdXww.
ELEVENLABS_VOICE_HYPE=
ELEVENLABS_VOICE_DRY=
ELEVENLABS_VOICE_DOCUMENTARY=
ELEVENLABS_VOICE_SUPPORTIVE=
ELEVENLABS_VOICE_DRILL=
ELEVENLABS_VOICE_CALM=

# Neon Lakebase Postgres (written by `neon init` / `neon deploy` / `neon env pull`).
# Prefer the pooled DATABASE_URL for the Next.js leaderboard route.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# NEON_BRANCH=
# NEON_BRANCH_ID=

# Optional Gemini next-workout ideas after a coached session. The key stays on the server.
# The request sends section scores and age only.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# No OpenAI integration is required for the core demo.
