# Optional for local demo; required for real ElevenLabs voice.
# Copy to .env.local. Never use NEXT_PUBLIC_ for secrets.
ELEVENLABS_API_KEY=

# Defaults used when blank/unset:
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Optional per-personality voice IDs; fall back to ELEVENLABS_VOICE_ID.
ELEVENLABS_VOICE_HYPE=
ELEVENLABS_VOICE_DRY=
ELEVENLABS_VOICE_DOCUMENTARY=
ELEVENLABS_VOICE_SUPPORTIVE=
ELEVENLABS_VOICE_DRILL=
ELEVENLABS_VOICE_CALM=

# Optional Neon Postgres for the shared scoreboard. The app works without it.
# DATABASE_URL=

# No OpenAI integration is implemented; no OpenAI key is needed.
